{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# rerun whenever fish_plugins changes: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -e

# brew bin may not be on PATH yet on a fresh machine
PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

if ! command -v fish >/dev/null 2>&1; then
	echo "fish not found, skipping fisher plugins" >&2
	exit 0
fi

fish -c '
functions -q fisher; or curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
fisher update
'
{{- end -}}
