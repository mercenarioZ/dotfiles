background-opacity = 0.9
background-blur-radius = 25
theme = Everforest Dark Hard
# match nvim everforest medium bg0, theme default is the darker hard bg_dim
background = #2d353b
minimum-contrast = 1

font-family = BlexMono Nerd Font
font-size = 14.5
font-thicken = true

cursor-color = fcee86
cursor-opacity = 0.8
cursor-style = block

# windows
window-height = 40
window-width = 110

window-padding-x = 8
window-padding-y = 8
window-padding-y = 8,0
window-padding-balance = true

macos-option-as-alt = left
