# theme = Catppuccin Mocha

background-opacity = 0.7
background-blur-radius = 16
background = #1e1e2e
minimum-contrast = 2

font-family = BlexMono Nerd Font
font-size = 17
font-thicken = true
font-thicken-strength = 25

cursor-color = fcee86
cursor-opacity = 0.9
cursor-style = block

# windows
window-height = 40
window-width = 110

window-padding-x = 8
window-padding-y = 8
window-padding-y = 8,0
window-padding-balance = true

macos-option-as-alt = left
