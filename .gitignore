.DS_Store

# neovim config files
/.nvimlog
dot_config/nvim/*.json
# the vim.pack lock is committed on purpose, so plugin revisions are reproducible
!dot_config/nvim/nvim-pack-lock.json
dot_config/nvim/*.toml
dot_config/nvim/LICENSE
*.log

# Machine-local shell configuration and credentials
.zshrc.local
.zsh-secrets
.env
.env.*
!.env.example

